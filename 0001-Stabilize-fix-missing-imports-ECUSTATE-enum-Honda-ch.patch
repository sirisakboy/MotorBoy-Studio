new file mode 100644
index 0000000..acb8265
--- /dev/null
+++ b/.github/workflows/ci.yml
@@ -0,0 +1,12 @@
+name: CI
+on: [push, pull_request]
+jobs:
+  test:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with: {python-version: "3.12"}
+      - run: pip install pytest pyflakes pydispatcher pylibftdi pyftdi
+      - run: python -m pyflakes src | grep -v "never used" | grep -v "may be undefined" || true
+      - run: python -m pytest -q tests
