diff --git a/tests/test_checksum.py b/tests/test_checksum.py
new file mode 100644
index 0000000..dee7f14
--- /dev/null
+++ b/tests/test_checksum.py
@@ -0,0 +1,33 @@
+import os, sys
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", "src"))
+
+import pytest
+from checksum import checksum8bitHonda, calculate_ecu_checksum, fix_checksum
+
+
+def test_honda_checksum_makes_rom_sum_zero():
+    rom = bytearray(range(256)) * 4
+    pos = 100
+    rom[pos] = checksum8bitHonda(rom[:pos] + rom[pos + 1:])
+    assert sum(rom) & 0xFF == 0
+
+
+def test_fix_checksum_in_place_and_bounds():
+    data = bytearray(16)
+    assert fix_checksum(data, 3, 0xAB)[3] == 0xAB
+    assert fix_checksum(data, 99, 0xFF) == data  # out of range: untouched
+    assert fix_checksum(data, -1, 0xFF) == data  # no negative wraparound
+
+
+def test_unknown_method():
+    with pytest.raises(ValueError):
+        calculate_ecu_checksum(b"\x00", "nope")
+
+
+def test_matches_eculib_reference():
+    ref = os.path.join(os.path.dirname(__file__), "..", "Hart-ECU")
+    sys.path.insert(0, ref)
+    honda = pytest.importorskip("eculib.honda")  # needs pylibftdi
+    ref_ck = honda.checksum8bitHonda
+    blob = bytes(range(200))
+    assert checksum8bitHonda(blob) == ref_ck(blob)
diff --git a/tests/test_ecustate.py b/tests/test_ecustate.py
new file mode 100644
index 0000000..c567ffa
--- /dev/null
+++ b/tests/test_ecustate.py
@@ -0,0 +1,16 @@
+import os, sys
+import pytest
+root = os.path.join(os.path.dirname(__file__), "..")
+sys.path[:0] = [os.path.join(root, "src"), os.path.join(root, "Hart-ECU")]
+pytest.importorskip("eculib.honda")  # needs pylibftdi / libftdi
+
+def test_extended_ecustate_is_real_enum():
+    from ecustate import ECUSTATE
+    assert ECUSTATE.SECURE.value == 100
+    assert ECUSTATE.OFF is ECUSTATE["OFF"]
+    assert ECUSTATE.OFF != ECUSTATE.UNKNOWN
+
+def test_eculib_patched():
+    import eculib.honda
+    from ecustate import ECUSTATE
+    assert eculib.honda.ECUSTATE is ECUSTATE
